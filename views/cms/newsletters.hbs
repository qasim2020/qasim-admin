<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Newsletters</h2>
                <div class="text-secondary mt-1">
                    {{#if (gt pagination.totalPages 1)}}
                    Showing {{pagination.from}}–{{pagination.to}} of {{pagination.total}} campaign{{#if (neq pagination.total 1)}}s{{/if}}
                    {{else}}
                    {{pagination.total}} campaign{{#if (neq pagination.total 1)}}s{{/if}}
                    {{/if}}
                </div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a href="/newsletters/new" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                    </svg>
                    New Campaign
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            {{#if items.length}}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Sent At</th>
                            <th>Recipients</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each items}}
                        <tr>
                            <td class="fw-medium">{{this.title}}</td>
                            <td class="text-secondary">{{this.subject}}</td>
                            <td>
                                {{#if (eq this.status 'sent')}}
                                <span class="badge bg-success-lt">Sent</span>
                                {{else}}
                                <span class="badge bg-secondary-lt">Draft</span>
                                {{/if}}
                            </td>
                            <td class="text-secondary">{{formatDate this.sentAt}}</td>
                            <td class="text-secondary">{{this.recipientCount}}</td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/newsletters/{{this._id}}/view"
                                        class="btn btn-sm btn-outline-secondary">View</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteItem('{{this._id}}', '{{this.title}}')">Delete</button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            {{#if (gt pagination.totalPages 1)}}
            <div class="d-flex align-items-center justify-content-between px-3 py-2">
                <div class="text-secondary small">Page {{pagination.page}} of {{pagination.totalPages}}</div>
                <ul class="pagination mb-0">
                    <li class="page-item {{#unless pagination.hasPrev}}disabled{{/unless}}">
                        <a class="page-link" href="/newsletters?page={{pagination.prevPage}}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18"/></svg>
                            prev
                        </a>
                    </li>
                    {{#each pagination.pages}}
                    {{#if this.ellipsis}}
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                    {{else}}
                    <li class="page-item {{#if this.active}}active{{/if}}">
                        <a class="page-link" href="/newsletters?page={{this.num}}">{{this.num}}</a>
                    </li>
                    {{/if}}
                    {{/each}}
                    <li class="page-item {{#unless pagination.hasNext}}disabled{{/unless}}">
                        <a class="page-link" href="/newsletters?page={{pagination.nextPage}}">
                            next
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 6 15 12 9 18"/></svg>
                        </a>
                    </li>
                </ul>
            </div>
            {{/if}}
            {{else}}
            <div class="card-body">
                <div class="empty">
                    <p class="empty-title">No campaigns yet</p>
                    <p class="empty-subtitle text-secondary">Create your first newsletter campaign to send to subscribers.</p>
                    <div class="empty-action">
                        <a href="/newsletters/new" class="btn btn-primary">Create campaign</a>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<script>
    async function deleteItem(id, title) {
        if (!confirm('Delete campaign "' + title + '"? This cannot be undone.')) return;
        try {
            const res = await fetch('/newsletters/' + id, { method: 'DELETE' });
            if (!res.ok) throw new Error('Request failed');
            window.location.reload();
        } catch (err) {
            alert('Failed to delete campaign.');
        }
    }
</script>
