<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="card card-md">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">Sign in to your account</h2>
                <form id="login-form" autocomplete="off" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" id="email" class="form-control" placeholder="your@email.com" autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Password
                            <span class="form-label-description">
                                <a href="/forgot-password">Forgot password?</a>
                            </span>
                        </label>
                        <input type="password" id="password" class="form-control" placeholder="Your password" autocomplete="current-password">
                    </div>
                    <div class="form-footer">
                        <button type="submit" id="submit-btn" class="btn btn-primary w-100">Sign in</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $('#login-form').on('submit', async function (e) {
        e.preventDefault();
        const $btn = $('#submit-btn');
        const originalHtml = $btn.html();
        $('form').find('.alert').remove();

        const email    = $('#email').val().trim();
        const password = $('#password').val();

        if (!email || !password) {
            appendAlert('danger', 'Please enter your email and password.');
            return;
        }

        $btn.html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Signing in');
        $btn.prop('disabled', true);

        try {
            await $.ajax({
                url: '/login',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ email, password }),
            });
            window.location.href = '/dashboard';
        } catch (err) {
            const msg = err.responseJSON?.error || 'Login failed. Please try again.';
            appendAlert('danger', msg);
            $btn.html(originalHtml).prop('disabled', false);
        }
    });

    function appendAlert(type, message) {
        $('form .form-footer').after(`
            <div class="alert alert-${type} mt-4" role="alert">
                <div class="text-secondary">${message}</div>
            </div>`);
    }
</script>
