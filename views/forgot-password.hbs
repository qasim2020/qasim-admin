<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="card card-md">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">Forgot password</h2>
                <p class="text-secondary text-center mb-4">
                    Enter your email and we'll send you a link to reset your password.
                </p>
                <form id="forgot-form" autocomplete="off" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" id="email" class="form-control" placeholder="your@email.com" autocomplete="off">
                    </div>
                    <div class="form-footer">
                        <button type="submit" id="submit-btn" class="btn btn-primary w-100">Send reset link</button>
                    </div>
                </form>
                <div class="text-center mt-3">
                    <a href="/login">← Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $('#forgot-form').on('submit', async function (e) {
        e.preventDefault();
        const $btn = $('#submit-btn');
        const originalHtml = $btn.html();
        $('form').find('.alert').remove();

        const email = $('#email').val().trim();
        if (!email) {
            appendAlert('danger', 'Please enter your email address.');
            return;
        }

        $btn.html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Sending');
        $btn.prop('disabled', true);

        try {
            await $.ajax({
                url: '/forgot-password',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ email }),
            });
            $('form').hide();
            appendAlert('success', 'If an account exists for that email, a reset link has been sent. Check your inbox (and spam folder).');
        } catch (err) {
            const msg = err.responseJSON?.error || 'Something went wrong. Please try again.';
            appendAlert('danger', msg);
            $btn.html(originalHtml).prop('disabled', false);
        }
    });

    function appendAlert(type, message) {
        $('#forgot-form').after(`
            <div class="alert alert-${type} mt-4" role="alert">
                <div class="text-secondary">${message}</div>
            </div>`);
    }
</script>
