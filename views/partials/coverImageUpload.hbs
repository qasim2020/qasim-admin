{{!--
  Cover-image upload widget.
  Usage: {{> coverImageUpload fieldId="field-cover-image"}}
  Requires: UPLOAD_URL and DELETE_URL globals set in the page's <script>.
--}}
<style>
  .cover-upload-box {
    width: 100%;
    aspect-ratio: 16 / 7;
    border: 2px dashed var(--tblr-border-color);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    position: relative;
    background: var(--tblr-bg-surface-secondary);
    transition: border-color .15s;
  }
  .cover-upload-box:hover { border-color: var(--tblr-gray-400); }
  .cover-upload-box.has-image { border-style: solid; }
  .cover-upload-box img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .cover-upload-box .cover-placeholder {
    display: flex; flex-direction: column;
    align-items: center; gap: 6px;
    color: var(--tblr-secondary);
    pointer-events: none;
    font-size: .85rem;
  }
  .cover-upload-box .cover-placeholder svg { width: 32px; height: 32px; opacity: .5; }
  .cover-upload-box .cover-remove {
    position: absolute; top: 8px; right: 8px;
    background: rgba(0,0,0,.55);
    border: none; border-radius: 50%;
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    color: #fff; cursor: pointer; font-size: 14px;
    display: none;
  }
  .cover-upload-box.has-image .cover-remove { display: flex; }
  .cover-upload-box .cover-spinner {
    position: absolute; inset: 0;
    background: rgba(255,255,255,.7);
    display: none; align-items: center; justify-content: center;
  }
  .cover-upload-box.uploading .cover-spinner { display: flex; }
</style>

<div class="cover-upload-box" id="cover-upload-box" onclick="coverUploadClick(event)">
  <img id="cover-preview" src="" alt="" style="display:none">
  <div class="cover-placeholder" id="cover-placeholder">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    <span>Click to upload cover image</span>
  </div>
  <button type="button" class="cover-remove" id="cover-remove" onclick="coverRemove(event)" title="Remove image">✕</button>
  <div class="cover-spinner" id="cover-spinner">
    <span class="spinner-border spinner-border-sm text-secondary"></span>
  </div>
</div>
<input type="file" id="cover-file-input" accept="image/*" style="display:none" onchange="coverFileSelected(event)">
<input type="hidden" id="field-cover-image" name="coverImage">
<input type="hidden" id="cover-public-id">
