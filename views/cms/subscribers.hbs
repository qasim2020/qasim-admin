<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Subscribers</h2>
                <div class="text-secondary mt-1">
                    {{counts.total}} total · {{counts.active}} active · {{counts.unsubscribed}} unsubscribed
                </div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <button class="btn btn-primary" onclick="openNew()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                    </svg>
                    Add Subscriber
                </button>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            {{#if items.length}}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Source</th>
                            <th>Subscribed</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each items}}
                        <tr>
                            <td class="fw-medium">{{this.email}}</td>
                            <td class="text-secondary">{{this.name}}</td>
                            <td>
                                {{#if (eq this.status 'active')}}
                                <span class="badge bg-success-lt">Active</span>
                                {{else if (eq this.status 'unsubscribed')}}
                                <span class="badge bg-secondary-lt">Unsubscribed</span>
                                {{else}}
                                <span class="badge bg-danger-lt">Bounced</span>
                                {{/if}}
                            </td>
                            <td class="text-secondary">{{this.source}}</td>
                            <td class="text-secondary">{{formatDate this.subscribedAt}}</td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <button class="btn btn-sm btn-outline-primary"
                                        onclick="editItem('{{this._id}}')">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteItem('{{this._id}}', '{{this.email}}')">Delete</button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="card-body">
                <div class="empty">
                    <p class="empty-title">No subscribers yet</p>
                    <p class="empty-subtitle text-secondary">Subscribers will appear here when they sign up from your portfolio.</p>
                    <div class="empty-action">
                        <button class="btn btn-primary" onclick="openNew()">Add subscriber manually</button>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal modal-blur fade" id="modal-form" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Add Subscriber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="item-form" onsubmit="submitForm(event)">
                <input type="hidden" id="item-id">
                <div class="modal-body">
                    <div id="form-error" class="alert alert-danger d-none mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required">Email</label>
                            <input type="email" id="field-email" class="form-control" placeholder="name@example.com"
                                required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Name</label>
                            <input type="text" id="field-name" class="form-control" placeholder="Full name">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Status</label>
                            <select id="field-status" class="form-select">
                                <option value="active">Active</option>
                                <option value="unsubscribed">Unsubscribed</option>
                                <option value="bounced">Bounced</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Source</label>
                            <input type="text" id="field-source" class="form-control" placeholder="e.g. footer-form">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="save-btn" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const BASE_URL = '/subscribers';

    function openNew() {
        document.getElementById('modal-title').textContent = 'Add Subscriber';
        document.getElementById('item-id').value = '';
        document.getElementById('item-form').reset();
        document.getElementById('form-error').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-form')).show();
    }

    async function editItem(id) {
        try {
            const res = await fetch(`${BASE_URL}/${id}`);
            const data = await res.json();
            document.getElementById('modal-title').textContent = 'Edit Subscriber';
            document.getElementById('item-id').value = data._id;
            document.getElementById('field-email').value = data.email || '';
            document.getElementById('field-name').value = data.name || '';
            document.getElementById('field-status').value = data.status || 'active';
            document.getElementById('field-source').value = data.source || '';
            document.getElementById('form-error').classList.add('d-none');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-form')).show();
        } catch (err) {
            alert('Failed to load subscriber data.');
        }
    }

    async function submitForm(e) {
        e.preventDefault();
        const id = document.getElementById('item-id').value;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `${BASE_URL}/${id}` : BASE_URL;
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

        try {
            const payload = {
                email: document.getElementById('field-email').value.trim(),
                name: document.getElementById('field-name').value.trim(),
                status: document.getElementById('field-status').value,
                source: document.getElementById('field-source').value.trim(),
            };
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                showError(data.error || 'An error occurred');
            }
        } catch (err) {
            showError('Network error. Please try again.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Save';
        }
    }

    async function deleteItem(id, email) {
        if (!confirm(`Permanently delete subscriber "${email}"? This cannot be undone.`)) return;
        const res = await fetch(`${BASE_URL}/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Delete failed');
        }
    }

    function showError(msg) {
        const el = document.getElementById('form-error');
        el.textContent = msg;
        el.classList.remove('d-none');
    }
</script>
