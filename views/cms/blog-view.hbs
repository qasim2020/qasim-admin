<!-- Page header -->
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <!-- Back link + title -->
            <div class="col">
                <div class="mb-1">
                    <a href="/blog" class="text-secondary small">
                        ← All posts
                    </a>
                </div>
                <h2 class="page-title">{{item.title}}</h2>
                <div class="text-secondary mt-1 d-flex flex-wrap gap-2 align-items-center">
                    {{#if (eq item.status 'published')}}
                    <span class="badge bg-success-lt">Published</span>
                    {{else}}
                    <span class="badge bg-secondary-lt">Draft</span>
                    {{/if}}
                    {{#if item.featured}}
                    <span class="badge bg-yellow-lt">★ Featured</span>
                    {{/if}}
                    {{#each item.categories}}
                    <span class="badge bg-blue-lt">{{this.name}}</span>
                    {{/each}}
                    <span class="text-muted">·</span>
                    <span>{{#if item.publishedAt}}{{formatDate item.publishedAt}}{{else}}{{formatDate item.createdAt}}{{/if}}</span>
                    {{#if item.readTimeMinutes}}
                    <span class="text-muted">·</span>
                    <span>{{item.readTimeMinutes}} min read</span>
                    {{/if}}
                </div>
                {{#if item.tags.length}}
                <div class="mt-2 d-flex flex-wrap gap-1">
                    {{#each item.tags}}
                    <span class="badge bg-secondary-lt">{{this.name}}</span>
                    {{/each}}
                </div>
                {{/if}}
            </div>

            <!-- Action buttons -->
            <div class="col-auto d-print-none">
                <div class="btn-list">
                    <a href="/blog/{{item._id}}/edit" class="btn btn-outline-secondary">
                        Edit Content
                    </a>
                    <button class="btn btn-outline-primary" onclick="openEdit()">
                        Settings
                    </button>
                    <button class="btn btn-outline-danger" onclick="deleteBlog()">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Blog content -->
<div class="page-body">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-8">
                {{#if item.coverImage}}
                <img src="{{item.coverImage}}" alt="{{item.title}}" class="img-fluid rounded mb-4 w-100" style="max-height:400px; object-fit:cover">
                {{/if}}

                <div class="card">
                    <div class="card-body blog-content">
                        {{{item.content}}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data for edit modal -->
<script>
    const AVAILABLE_TAGS = [{{#each tags}}{ id: '{{this._id}}', name: '{{this.name}}' }{{#unless @last}},{{/unless}}{{/each}}];
</script>

<!-- Edit Modal -->
<div class="modal modal-blur fade" id="modal-edit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Post</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="edit-form" onsubmit="savePost(event)">
                    <input type="hidden" id="item-id" value="{{item._id}}">
                    <div id="form-error" class="alert alert-danger d-none mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required">Title</label>
                            <input type="text" id="field-title" class="form-control" value="{{item.title}}" required>
                        </div>
                        <div class="col-9">
                            <label class="form-label">Slug</label>
                            <input type="text" id="field-slug" class="form-control" value="{{item.slug}}">
                        </div>
                        <div class="col-3">
                            <label class="form-label">Read Time (min)</label>
                            <input type="number" id="field-read-time" class="form-control" value="{{item.readTimeMinutes}}" min="1">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Excerpt</label>
                            <textarea id="field-excerpt" class="form-control" rows="2">{{item.excerpt}}</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cover Image URL</label>
                            <input type="url" id="field-cover-image" class="form-control" value="{{item.coverImage}}" placeholder="https://...">
                        </div>
                        <div class="col-4">
                            <label class="form-label">Status</label>
                            <select id="field-status" class="form-select">
                                <option value="draft" {{#if (eq item.status 'draft')}}selected{{/if}}>Draft</option>
                                <option value="published" {{#if (eq item.status 'published')}}selected{{/if}}>Published</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label">Read Time (min)</label>
                            <input type="number" id="field-read-time" class="form-control" min="1" value="{{item.readTimeMinutes}}" placeholder="5">
                        </div>
                        <div class="col-4">
                            <label class="form-label">SEO Title</label>
                            <input type="text" id="field-seo-title" class="form-control" value="{{item.seoTitle}}">
                        </div>
                        <div class="col-12">
                            <label class="form-label">SEO Description</label>
                            <textarea id="field-seo-description" class="form-control" rows="2">{{item.seoDescription}}</textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tags</label>
                            <div id="tag-badges" class="d-flex flex-wrap gap-1 mb-2"></div>
                            <div class="">
                                <input type="text" id="tag-search" class="form-control"
                                    placeholder="Search and add tags…" autocomplete="off">
                            </div>
                            <div id="tag-dropdown" class="border rounded bg-white shadow-sm mt-1 d-none"
                                style="max-height:200px;overflow-y:auto;position:relative;z-index:10;">
                            </div>
                            <select id="field-tags" class="d-none" multiple></select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="edit-form" id="save-btn" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Blog content typography */
    .blog-content { font-size: 1.05rem; line-height: 1.8; }
    .blog-content h1, .blog-content h2, .blog-content h3,
    .blog-content h4, .blog-content h5, .blog-content h6 { margin-top: 1.5rem; margin-bottom: .75rem; }
    .blog-content p { margin-bottom: 1rem; }
    .blog-content img { max-width: 100%; height: auto; display: block; margin: 1rem auto; }
    .blog-content pre { background: #f4f6fa; border-radius: .375rem; padding: 1rem; overflow-x: auto; }
    .blog-content blockquote { border-left: 4px solid #f59f00; padding-left: 1rem; color: #666; }
    .blog-content .verses { background: #f8f9fa; border-radius: .375rem; padding: 1rem 1.5rem; text-align: center; font-style: italic; margin: 1rem 0; }
    .blog-content details summary { cursor: pointer; }
    .blog-content ul { padding-left: 1.5rem; }
    .blog-content .alert { margin: 1rem 0; }
    .blog-content .ratio { margin: 1rem 0; }
</style>

<script>
    const POST_ID  = '{{item._id}}';

    // ── Tag Badge Picker ─────────────────────────────────────────────────────────────
    const tagSelect   = document.getElementById('field-tags');
    const tagBadges   = document.getElementById('tag-badges');
    const tagSearch   = document.getElementById('tag-search');
    const tagDropdown = document.getElementById('tag-dropdown');

    AVAILABLE_TAGS.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id;
        opt.dataset.name = t.name;
        tagSelect.appendChild(opt);
    });

    function getSelectedTagIds() {
        return Array.from(tagSelect.options).filter(o => o.selected).map(o => o.value);
    }

    function renderBadges() {
        tagBadges.innerHTML = '';
        Array.from(tagSelect.options).filter(o => o.selected).forEach(o => {
            const badge = document.createElement('span');
            badge.className = 'badge bg-blue-lt d-inline-flex align-items-center gap-1 px-2 py-1';
            badge.style.fontSize = '0.8rem';
            badge.innerHTML = o.dataset.name + ' <button type="button" class="btn-close btn-close-sm" style="font-size:0.6rem" aria-label="Remove"></button>';
            badge.querySelector('button').addEventListener('click', () => {
                const found = Array.from(tagSelect.options).find(x => x.value === o.value);
                if (found) found.selected = false;
                renderBadges();
            });
            tagBadges.appendChild(badge);
        });
    }

    function renderDropdown(filter) {
        tagDropdown.innerHTML = '';
        const q = (filter || '').toLowerCase();
        const selectedIds = new Set(getSelectedTagIds());
        const matches = AVAILABLE_TAGS.filter(t =>
            t.name.toLowerCase().includes(q) && !selectedIds.has(t.id)
        ).slice(0, 50);
        if (!matches.length) {
            tagDropdown.innerHTML = '<div class="px-3 py-2 text-muted small">No results</div>';
        } else {
            matches.forEach(t => {
                const row = document.createElement('div');
                row.className = 'px-3 py-1';
                row.style.cssText = 'cursor:pointer;user-select:none';
                row.textContent = t.name;
                row.addEventListener('mousedown', e => {
                    e.preventDefault();
                    const opt = Array.from(tagSelect.options).find(x => x.value === t.id);
                    if (opt) opt.selected = true;
                    renderBadges();
                    tagSearch.value = '';
                    tagDropdown.classList.add('d-none');
                });
                row.addEventListener('mouseover', () => row.classList.add('bg-light'));
                row.addEventListener('mouseout',  () => row.classList.remove('bg-light'));
                tagDropdown.appendChild(row);
            });
        }
        tagDropdown.classList.remove('d-none');
    }

    tagSearch.addEventListener('focus', () => renderDropdown(tagSearch.value));
    tagSearch.addEventListener('input', () => renderDropdown(tagSearch.value));
    tagSearch.addEventListener('blur',  () => setTimeout(() => tagDropdown.classList.add('d-none'), 150));

    // Pre-select existing tags and render badges
    const preSelectedTagIds = [{{#each item.tags}}'{{this._id}}'{{#unless @last}},{{/unless}}{{/each}}];
    Array.from(tagSelect.options).forEach(o => { o.selected = preSelectedTagIds.includes(o.value); });
    renderBadges();
    // ───────────────────────────────────────────────────────────────────────────

    function openEdit() {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-edit')).show();
    }

    async function savePost(e) {
        e.preventDefault();
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        try {
            const payload = {
                title:          document.getElementById('field-title').value.trim(),
                slug:           document.getElementById('field-slug').value.trim(),
                excerpt:        document.getElementById('field-excerpt').value.trim(),
                coverImage:     document.getElementById('field-cover-image').value.trim(),
                status:         document.getElementById('field-status').value,
                readTimeMinutes: parseInt(document.getElementById('field-read-time').value) || undefined,
                tags:           getSelectedTagIds(),
                seoTitle:       document.getElementById('field-seo-title').value.trim(),
                seoDescription: document.getElementById('field-seo-description').value.trim(),
            };
            const res  = await fetch(`/blog/${POST_ID}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                const el = document.getElementById('form-error');
                el.textContent = data.error || 'An error occurred';
                el.classList.remove('d-none');
            }
        } catch (err) {
            const el = document.getElementById('form-error');
            el.textContent = 'Network error. Please try again.';
            el.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Save';
        }
    }

    async function deleteBlog() {
        const title = document.querySelector('.page-title').textContent;
        if (!confirm(`Delete "${title}"? This cannot be undone.`)) return;
        const res  = await fetch(`/blog/${POST_ID}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            window.location.href = '/blog';
        } else {
            alert(data.error || 'Delete failed');
        }
    }
</script>
