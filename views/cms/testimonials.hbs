<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Testimonials</h2>
                <div class="text-secondary mt-1">{{items.length}} testimonial{{#if (neq items.length 1)}}s{{/if}}</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <button class="btn btn-primary" onclick="openNew()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                    </svg>
                    New Testimonial
                </button>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            {{#if items.length}}
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Author</th>
                            <th>Role / Company</th>
                            <th>Quote</th>
                            <th>Featured</th>
                            <th>Order</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each items}}
                        <tr>
                            <td class="fw-medium">{{this.author}}</td>
                            <td class="text-secondary">
                                {{#if this.role}}{{this.role}}{{/if}}
                                {{#if (and this.role this.company)}} · {{/if}}
                                {{#if this.company}}{{this.company}}{{/if}}
                            </td>
                            <td class="text-secondary" style="max-width:260px;">
                                <span class="text-truncate d-block" title="{{this.content}}">{{this.content}}</span>
                            </td>
                            <td>
                                {{#if this.featured}}
                                <span class="badge bg-yellow-lt">Featured</span>
                                {{else}}
                                <span class="text-secondary">—</span>
                                {{/if}}
                            </td>
                            <td class="text-secondary">{{this.order}}</td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <button class="btn btn-sm btn-outline-primary"
                                        onclick="editItem('{{this._id}}')">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteItem('{{this._id}}', '{{this.author}}')">Delete</button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="card-body">
                <div class="empty">
                    <p class="empty-title">No testimonials yet</p>
                    <p class="empty-subtitle text-secondary">Add testimonials from colleagues and clients.</p>
                    <div class="empty-action">
                        <button class="btn btn-primary" onclick="openNew()">Add first testimonial</button>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal modal-blur fade" id="modal-form" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">New Testimonial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="item-form" onsubmit="submitForm(event)">
                <input type="hidden" id="item-id">
                <div class="modal-body">
                    <div id="form-error" class="alert alert-danger d-none mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required">Author Name</label>
                            <input type="text" id="field-author" class="form-control" placeholder="e.g. Jane Smith"
                                required>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Role</label>
                            <input type="text" id="field-role" class="form-control" placeholder="e.g. CTO">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Company</label>
                            <input type="text" id="field-company" class="form-control" placeholder="e.g. Acme Inc.">
                        </div>
                        <div class="col-12">
                            <label class="form-label required">Quote / Content</label>
                            <textarea id="field-content" class="form-control" rows="4"
                                placeholder="What they said…" required></textarea>
                        </div>
                        <div class="col-8">
                            <label class="form-label">Avatar URL</label>
                            <input type="url" id="field-avatar" class="form-control"
                                placeholder="https://...">
                        </div>
                        <div class="col-2">
                            <label class="form-label">Order</label>
                            <input type="number" id="field-order" class="form-control" value="0" min="0">
                        </div>
                        <div class="col-2 d-flex align-items-end pb-1">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="field-featured">
                                <span class="form-check-label">Featured</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="save-btn" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const BASE_URL = '/testimonials';

    function openNew() {
        document.getElementById('modal-title').textContent = 'New Testimonial';
        document.getElementById('item-id').value = '';
        document.getElementById('item-form').reset();
        document.getElementById('field-order').value = '0';
        document.getElementById('form-error').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-form')).show();
    }

    async function editItem(id) {
        try {
            const res = await fetch(`${BASE_URL}/${id}`);
            const data = await res.json();
            document.getElementById('modal-title').textContent = 'Edit Testimonial';
            document.getElementById('item-id').value = data._id;
            document.getElementById('field-author').value = data.author || '';
            document.getElementById('field-role').value = data.role || '';
            document.getElementById('field-company').value = data.company || '';
            document.getElementById('field-content').value = data.content || '';
            document.getElementById('field-avatar').value = data.avatar || '';
            document.getElementById('field-order').value = data.order ?? 0;
            document.getElementById('field-featured').checked = !!data.featured;
            document.getElementById('form-error').classList.add('d-none');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-form')).show();
        } catch (err) {
            alert('Failed to load testimonial data.');
        }
    }

    async function submitForm(e) {
        e.preventDefault();
        const id = document.getElementById('item-id').value;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `${BASE_URL}/${id}` : BASE_URL;
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';

        try {
            const payload = {
                author: document.getElementById('field-author').value.trim(),
                role: document.getElementById('field-role').value.trim(),
                company: document.getElementById('field-company').value.trim(),
                content: document.getElementById('field-content').value.trim(),
                avatar: document.getElementById('field-avatar').value.trim(),
                order: parseInt(document.getElementById('field-order').value) || 0,
                featured: document.getElementById('field-featured').checked,
            };
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                showError(data.error || 'An error occurred');
            }
        } catch (err) {
            showError('Network error. Please try again.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Save';
        }
    }

    async function deleteItem(id, name) {
        if (!confirm(`Delete testimonial from "${name}"? This cannot be undone.`)) return;
        const res = await fetch(`${BASE_URL}/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Delete failed');
        }
    }

    function showError(msg) {
        const el = document.getElementById('form-error');
        el.textContent = msg;
        el.classList.remove('d-none');
    }
</script>
